# Railway MySQL + Backend example env
# Copy to .env and replace values with Railway-provided variables

PORT=5000
NODE_ENV=production

# Railway MySQL plugin will provide these values (example keys)
DB_HOST=your_railway_mysql_host
DB_PORT=3306
DB_USER=your_railway_mysql_user
DB_PASSWORD=your_railway_mysql_password
DB_NAME=potentat_db

JWT_SECRET=super_secret_jwt_key
JWT_EXPIRES_IN=24h
